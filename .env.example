# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋되지 않는다.
#
# 공용 학원 PC 를 쓴다면 .env 를 PC 에 남기지 말고 실행파일과 함께 USB 에 둔다
# (PRD FR-054). 세션 종료 안내가 잔존 여부를 확인시켜 준다 (FR-053).

# OpenAI — 요약 생성. 전용 프로젝트를 만들고 지출 한도를 걸어두길 권장한다.
OPENAI_API_KEY=

# Discord Webhook — 팀 채널 전송.
# 인증이 없다. URL 을 아는 사람은 누구나 그 채널에 글을 쓸 수 있으므로
# 비밀값으로 취급하고, 노출되면 즉시 삭제·재발급한다.
DISCORD_WEBHOOK_URL=
